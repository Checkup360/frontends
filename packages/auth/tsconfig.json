{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@workspace/api": ["../api/src/index.ts"],
      "@workspace/ui/*": ["../ui/src/*"],
      "@workspace/api/*": ["../api/src/*"],
      "@workspace/auth/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
