{
  "name": "Checkup360",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "precommit": "pnpm lint && pnpm typecheck && pnpm build",
    "prepare": "simple-git-hooks"
  },
  "pnpm": {
    "overrides": {
      "path-scurry>lru-cache": "^10.2.0"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": "bash -c 'pnpm turbo typecheck build'"
  },
  "devDependencies": {
    "lint-staged": "^15.2.11",
    "lru-cache": "10",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "simple-git-hooks": "^2.12.1",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
